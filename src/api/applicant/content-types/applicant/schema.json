{
	"kind": "collectionType",
	"collectionName": "applicants",
	"info": {
		"singularName": "applicant",
		"pluralName": "applicants",
		"displayName": "Applicants"
	},
	"options": {
		"draftAndPublish": false
	},
	"pluginOptions": {},
	"attributes": {
		"fullName": {
			"type": "string",
			"required": true
		},
		"currentLocation": {
			"type": "string",
			"required": true
		},
		"gccExperience": {
			"type": "enumeration",
			"required": true,
			"enum": [
				"yes",
				"no"
			]
		},
		"email": {
			"type": "email",
			"required": true
		},
		"phone": {
			"type": "string",
			"required": true
		},
		"experienceYears": {
			"type": "integer",
			"required": true,
			"min": 0,
			"max": 50
		},
		"nationality": {
			"type": "string",
			"required": true
		},
		"photo": {
			"type": "media",
			"multiple": false,
			"required": true,
			"allowedTypes": [
				"images"
			]
		},
		"cv": {
			"type": "media",
			"multiple": false,
			"required": true,
			"allowedTypes": [
				"files"
			]
		},
		"coverLetter": {
			"type": "media",
			"multiple": false,
			"required": false,
			"allowedTypes": [
				"files"
			]
		},
		"label": {
			"type": "enumeration",
			"required": true,
			"default": "new",
			"enum": [
				"new",
				"shortlisted",
				"interview",
				"hired",
				"rejected"
			]
		},
		"adminNotes": {
			"type": "text"
		},
		"appliedAt": {
			"type": "datetime",
			"required": true
		},
		"user": {
			"type": "relation",
			"relation": "manyToOne",
			"target": "plugin::users-permissions.user"
		},
		"applied_job": {
			"type": "relation",
			"relation": "manyToOne",
			"target": "api::job.job"
		}
	}
}
