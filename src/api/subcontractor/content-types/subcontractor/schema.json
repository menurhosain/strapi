{
	"kind": "collectionType",
	"collectionName": "subcontractors",
	"info": {
		"singularName": "subcontractor",
		"pluralName": "subcontractors",
		"displayName": "Subcontractors"
	},
	"options": {
		"draftAndPublish": false
	},
	"pluginOptions": {},
	"attributes": {
		"companyName": {
			"type": "string",
			"required": true
		},
		"email": {
			"type": "email",
			"required": true
		},
		"phone": {
			"type": "string"
		},
		"documents": {
			"type": "media",
			"multiple": true,
			"required": false,
			"allowedTypes": [
				"files",
				"images"
			]
		},
		"experienceYears": {
			"type": "integer",
			"min": 0,
			"max": 100
		},
		"location": {
			"type": "string"
		},
		"label": {
			"type": "enumeration",
			"required": true,
			"default": "New",
			"enum": [
				"New",
				"Approved",
				"Contacted",
				"Rejected"
			]
		},
		"adminNotes": {
			"type": "text"
		},
		"appliedAt": {
			"type": "datetime",
			"required": true
		},
		"user": {
			"type": "relation",
			"relation": "manyToOne",
			"target": "plugin::users-permissions.user"
		},
		"applied_on_project": {
			"type": "relation",
			"relation": "manyToOne",
			"target": "api::subcontracted.subcontracted"
		}
	}
}
