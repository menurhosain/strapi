{
	"kind": "collectionType",
	"collectionName": "subcontractors",
	"info": {
		"singularName": "subcontractor",
		"pluralName": "subcontractors",
		"displayName": "Subcontractors"
	},
	"options": {
		"draftAndPublish": false
	},
	"pluginOptions": {},
	"attributes": {
		"fullName": {
			"type": "string",
			"required": true
		},
		"title": {
			"type": "string",
			"required": true
		},
		"phone": {
			"type": "string",
			"required": true
		},
		"email": {
			"type": "email",
			"required": true
		},
		"companyName": {
			"type": "string",
			"required": true
		},
		"registrationNumber": {
			"type": "string",
			"required": true
		},
		"foundingYear": {
			"type": "integer",
			"required": true,
			"min": 1800,
			"max": 2100
		},
		"mainTrades": {
			"type": "text",
			"required": true
		},
		"country": {
			"type": "string",
			"required": true
		},
		"state": {
			"type": "string",
			"required": true
		},
		"city": {
			"type": "string",
			"required": true
		},
		"address": {
			"type": "string",
			"required": true
		},
		"postalCode": {
			"type": "string",
			"required": true
		},
		"companyPhone": {
			"type": "string",
			"required": true
		},
		"ext": {
			"type": "string"
		},
		"taxId": {
			"type": "string",
			"required": true
		},
		"documents": {
			"type": "media",
			"multiple": true,
			"required": true,
			"allowedTypes": [
				"files"
			]
		},
		"description": {
			"type": "text",
			"required": true
		},
		"label": {
			"type": "enumeration",
			"required": true,
			"default": "New",
			"enum": [
				"New",
				"Approved",
				"Contacted",
				"Rejected"
			]
		},
		"adminNotes": {
			"type": "text"
		},
		"appliedAt": {
			"type": "datetime",
			"required": true
		},
		"user": {
			"type": "relation",
			"relation": "manyToOne",
			"target": "plugin::users-permissions.user"
		},
		"applied_on_project": {
			"type": "relation",
			"relation": "manyToOne",
			"target": "api::subcontracted.subcontracted"
		}
	}
}
